<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>StationGodMCP</AssemblyName>
    <RootNamespace>StationGodMCP</RootNamespace>
    <Version>2.13.0</Version>
    <Authors>XCeled</Authors>
    <Description>Lets an AI agent read and operate a running Stationeers game through the Model Context Protocol.</Description>
    <LangVersion>12.0</LangVersion>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The tests, build output, package/ and reference/ hold assemblies; none of them are items of the mod. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;reference\**;package\**;**\bin\**;**\obj\**</DefaultItemExcludes>
    <!-- References resolve from their HintPath only. The SDK default searches {CandidateAssemblyFiles} first: any dll
         among the project's items, so a same-named net8 dll anywhere under the repo would win over the game's copy. -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- The LINQ ban (BannedSymbols.txt) is an error, not a warning: the cost gate's source rule (CostSourceRulesTests). -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    <!-- Override with -p:StationeersPath=... or the STATIONEERS_DIR environment variable. -->
    <StationeersPath Condition="'$(StationeersPath)' == '' And '$(STATIONEERS_DIR)' != ''">$(STATIONEERS_DIR)</StationeersPath>
    <StationeersPath Condition="'$(StationeersPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stationeers</StationeersPath>
    <ManagedPath>$(StationeersPath)\rocketstation_Data\Managed</ManagedPath>
    <BepInExCorePath>$(StationeersPath)\BepInEx\core</BepInExCorePath>
    <LaunchPadPath>$(StationeersPath)\BepInEx\plugins\StationeersLaunchPad</LaunchPadPath>
    <!-- Lattice's contract (Lattice.Api.dll, never shipped): -p:LatticeApiDir=..., the LATTICE_API_DIR environment
         variable, else the Lattice repo's build beside this one. -->
    <LatticeApiDir Condition="'$(LatticeApiDir)' == '' And '$(LATTICE_API_DIR)' != ''">$(LATTICE_API_DIR)</LatticeApiDir>
    <LatticeApiDir Condition="'$(LatticeApiDir)' == ''">$(MSBuildThisFileDirectory)..\Lattice\artifacts\Release\Lattice</LatticeApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\StationGodMCP.Mod\**\*.cs" />
    <!-- The built-in lint rules: always loaded, with the save's lint-rules.json over them; the mod folder's copy is never loaded. -->
    <EmbeddedResource Include="lint-rules.json" LogicalName="StationGodMCP.lint-rules.json" />
    <!-- The verb model (catalogue/verbs), the one catalogue the mod carries: its files' bytes with every line ending
         a bare LF are the hash the welcome announces, and the assembled document is what the `catalogue` method
         answers. The Client and the Server embed the same glob with the same logical names. -->
    <EmbeddedResource Include="catalogue\verbs\*.json" LogicalName="catalogue/verbs/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analyzers only: nothing is shipped with the mod. -->
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.21.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCorePath)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCorePath)\0Harmony.dll" Private="false" />
    <Reference Include="StationeersMods.Interface" HintPath="$(LaunchPadPath)\StationeersMods.Interface.dll" Private="false" />
    <!-- Multiplayer messages (Net/): only touched once StationGodNet.Register found it, never shipped with the mod. -->
    <Reference Include="LaunchPadBooster" HintPath="$(LaunchPadPath)\LaunchPadBooster.dll" Private="false" />
    <!-- Lattice (optional at run time): only touched once LatticePresence found it loaded (LatticeLink/). -->
    <Reference Include="Lattice.Api" HintPath="$(LatticeApiDir)\Lattice.Api.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedPath)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedPath)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedPath)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedPath)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedPath)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedPath)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedPath)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyPluginToModRoot" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)" />
    <!-- LaunchPad scans enabled mod directories recursively. Keep one loadable mod DLL. -->
    <Delete Files="$(TargetPath);$(IntermediateOutputPath)$(TargetFileName)" />
  </Target>
</Project>
