<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>StationGodMCP.Server</AssemblyName>
    <RootNamespace>StationGodMCP.Server</RootNamespace>
    <!-- One version with the mod: build.ps1 checks this, Program.ServerVersion, the mod and About.xml agree. -->
    <Version>1.31.0</Version>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StationGodMCP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The protocol client. It embeds the method catalogue the tools come from (the repository root's catalogue.json,
         assembled from catalogue/). -->
    <ProjectReference Include="..\StationGodMCP.Client\StationGodMCP.Client.csproj" />
  </ItemGroup>
</Project>
