<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>StationGodMCP.Server</AssemblyName>
    <RootNamespace>StationGodMCP.Server</RootNamespace>
    <!-- One version with the mod: build.ps1 checks this, Program.ServerVersion, the mod and About.xml agree. -->
    <Version>1.10.0</Version>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StationGodMCP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The method catalogue the tools come from (the repository root's catalogue.json, assembled from catalogue/). -->
    <EmbeddedResource Include="..\..\catalogue.json" LogicalName="StationGodMCP.catalogue.json" />
  </ItemGroup>
</Project>
