<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>StationGodMCP.Server</AssemblyName>
    <RootNamespace>StationGodMCP.Server</RootNamespace>
    <!-- One version with the mod: build.ps1 checks this, Program.ServerVersion, the mod and About.xml agree. -->
    <Version>1.33.2</Version>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StationGodMCP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The protocol client. It embeds the verb model (catalogue/verbs; SHA-256 of these files' bytes with every
         line ending a bare LF is the catalogue hash the mod announces). -->
    <ProjectReference Include="..\StationGodMCP.Client\StationGodMCP.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The verbs: their source (VerbCatalogue reads options, handlers and write rules from it) and what is generated
         from it (the tools array, help pages and Python stubs), served as they are. -->
    <EmbeddedResource Include="..\..\catalogue\verbs\*.json" LogicalName="catalogue/verbs/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\generated\verbs\tools.json" LogicalName="generated/verbs/tools.json" />
    <EmbeddedResource Include="..\..\generated\verbs\help\*.txt" LogicalName="generated/verbs/help/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\generated\verbs\stubs\*.py" LogicalName="generated/verbs/stubs/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sg package the script workers run (hub.md, Runs): shipped next to the binary, in python/sg. -->
    <Content Include="..\..\clients\python\sg\**\*" Exclude="..\..\clients\python\sg\**\__pycache__\**"
             Link="python\sg\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
