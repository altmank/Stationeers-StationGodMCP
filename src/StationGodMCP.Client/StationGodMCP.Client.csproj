<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The C# client of the StationGod protocol (docs/architecture/clients.md): connecting over a pipe or TCP, version 2
    with the fall back to version 1, signing in, one connection with several calls in flight, resending only what the
    catalogue calls safe, subscriptions, and output_file on the caller's machine. No dependencies.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>StationGodMCP.Client</AssemblyName>
    <RootNamespace>StationGodMCP.Client</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StationGodMCP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The verb model the client was built with (the repository's catalogue/verbs); its hash is SHA-256 of these
         files' raw bytes, concatenated in ordinal file-name order - the hash the mod announces in welcome. -->
    <EmbeddedResource Include="..\..\catalogue\verbs\*.json" LogicalName="catalogue/verbs/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
