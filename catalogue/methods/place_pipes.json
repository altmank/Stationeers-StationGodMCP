{
  "name": "place_pipes",
  "summary": "Lay a pipe run, or pieces, as place_cables lays cable: one-cell pieces from the grade's kit (gas, liquid, insulated_gas, insulated_liquid; grade required), with the pipe guards and a gas check. Dry run by default; confirm to build.",
  "help": {
    "text": "The same run forms, joins, placement check, removals, dry run, job and guards as place_cables, with kits instead of coils (not_enough_coils names what is missing). networks_before lists each pipe network with content, total_mol, temperature, pressure, volume, main gases and devices. A long straight split to be joined keeps its network and contents, even as the network's only pipe: its singles take its network on and the new pieces are built outward from them.",
    "keys": "job_id, status, ready, problems [], warnings [], cells [], removals [], final_check, log, gas_check, error.",
    "shared": ["runs", "jobs", "networks", "refunds", "materials", "doors", "lint", "pipes", "gas_hold"]
  },
  "class": "write",
  "x-class-when": [{"when": {"dry_run": {"absent": true}}, "class": "read"}, {"when": {"dry_run": {"equals": true}}, "class": "read"}],
  "cost": "job",
  "x-cost-when": [
    {"when": {"job_id": {"present": true}}, "cost": "instant"},
    {"when": {"dry_run": {"absent": true}}, "cost": "plan"},
    {"when": {"dry_run": {"equals": true}}, "cost": "plan"}
  ],
  "params": {
    "type": "object",
    "properties": {
      "waypoints": {"$ref": "defs/waypoints.json"},
      "cells": {"$ref": "defs/cells.json"},
      "piece": {"$ref": "defs/piece.json"},
      "pieces": {"$ref": "defs/pieces.json"},
      "grade": {
        "type": "string",
        "enum": ["gas", "liquid", "insulated_gas", "insulated_liquid"],
        "description": "gas, liquid, insulated_gas or insulated_liquid; required except with job_id."
      },
      "join": {
        "type": "string",
        "enum": ["ends", "none", "all"],
        "description": "ends (default), none or all (see runs/joins)."
      },
      "branches": {"$ref": "defs/branches.json"},
      "allow_door_keepout": {"$ref": "defs/allow_door_keepout.json"},
      "allow_split_long": {"$ref": "defs/allow_split_long.json"},
      "extra_ends": {"$ref": "defs/extra_ends.json"},
      "remove_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1024,
        "items": {"type": "string"},
        "description": "Pipe pieces removed in the same job before building (see runs/assume_removed)."
      },
      "assume_removed": {"$ref": "defs/assume_removed.json"},
      "allow_bridge": {"$ref": "defs/allow_bridge.json"},
      "root": {"$ref": "defs/root.json"},
      "join_to": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "properties": {
              "reference_id": {"type": "string", "description": "A device or piece on the network."},
              "port": {"type": "integer", "minimum": 0, "maximum": 64, "description": "The device's port index."}
            },
            "required": ["reference_id"],
            "additionalProperties": false
          }
        ],
        "description": "The pipe network the run must end up on (see runs/taps)."
      },
      "join_trunk": {"$ref": "defs/join_trunk.json"},
      "wait": {"$ref": "defs/wait.json"},
      "allow_split": {"$ref": "defs/allow_split.json"},
      "dry_run": {"$ref": "defs/dry_run.json"},
      "confirm": {"$ref": "defs/confirm.json"},
      "from_id": {
        "type": "string",
        "description": "The thing whose inventory gives the coils or kits and takes the refund. Default the player."
      },
      "refund": {
        "type": "boolean",
        "description": "Give back what removed pieces and cheaper changes return. Default true; false is refund_to none."
      },
      "refund_to": {"$ref": "defs/refund_to.json"},
      "include_links": {"$ref": "defs/include_links.json"},
      "include_notes": {"$ref": "defs/include_notes.json"},
      "include_network_devices": {"$ref": "defs/include_network_devices.json"},
      "limit": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1024,
        "description": "Cells listed; default 5, 0 for none. All are counted and checked."
      },
      "verbose": {"$ref": "defs/verbose.json"},
      "job_id": {"$ref": "defs/job_id.json"},
      "acknowledge_gas_lost": {"$ref": "defs/acknowledge_gas_lost.json"}
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "job_id": {"type": ["string", "null"]},
      "tool": {"type": "string"},
      "status": {"type": "string"},
      "position": {"type": "integer"},
      "running_job_id": {"type": ["string", "null"]},
      "preflight": {},
      "preflight_summary": {"type": ["object", "null"]},
      "final_check": {"type": ["object", "null"]},
      "log": {"type": ["object", "null"]},
      "verification": {"type": ["object", "null"]},
      "gas_check": {"type": ["object", "null"]},
      "error": {"type": ["object", "null"]},
      "grade": {"type": ["string", "null"]},
      "ready": {"type": "boolean"},
      "problems": {"type": "array"},
      "warnings": {"type": "array"},
      "cells_total": {"type": "integer"},
      "placed": {"type": "integer"},
      "changed": {"type": "integer"},
      "kept": {"type": "integer"},
      "removed_count": {"type": "integer"},
      "air_cells": {"type": ["integer", "null"]},
      "cells": {"type": "array"},
      "removals": {"type": "array"},
      "materials": {"type": "object"},
      "networks_before": {"type": "array"},
      "networks_after": {"type": "array"},
      "would_bridge": {"type": "array"},
      "would_split": {"type": "array"},
      "links": {"type": ["object", "null"]},
      "notes": {"type": ["array", "null"]},
      "result": {"type": ["object", "null"]},
      "waiting": {"type": "integer"},
      "message": {"type": "string"}
    }
  },
  "x-views": ["JobQueuedView", "RunJobView", "RunReportView", "BuildJobView", "JobBusyView", "JobDroppedView"],
  "x-shaping": "lists",
  "x-job": {"poll_param": "job_id"},
  "x-read-by": {"allow_bridge": "Api/PlaceRuns.cs"}
}
