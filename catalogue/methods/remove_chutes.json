{
  "name": "remove_chutes",
  "summary": "Remove chute pieces (straights, corners, junctions, valves, overflows, splitters) as a player's deconstruction does: by id or cell. Refunds the kits. Dry run by default; confirm to remove.",
  "help": {
    "text": "A piece with an item riding in it is cannot_remove (the game would lose the item; let it pass or take it out with move_item). drops_items warns where the removal leaves an end items would fall out of. The networks around every removed chute take new ids.",
    "shared": ["removals", "runs", "jobs", "refunds", "networks", "materials"]
  },
  "class": "write",
  "x-class-when": [{"when": {"dry_run": {"absent": true}}, "class": "read"}, {"when": {"dry_run": {"equals": true}}, "class": "read"}],
  "cost": "job",
  "x-cost-when": [
    {"when": {"job_id": {"present": true}}, "cost": "instant"},
    {"when": {"dry_run": {"absent": true}}, "cost": "plan"},
    {"when": {"dry_run": {"equals": true}}, "cost": "plan"}
  ],
  "params": {
    "type": "object",
    "properties": {
      "reference_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1024,
        "items": {"type": "string"},
        "description": "Chute pieces to remove; or give waypoints or cells."
      },
      "waypoints": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1024,
        "items": {"description": "[x, y, z] or {x, y, z} in metres."},
        "description": "Remove the chute in every cell along these straight lines."
      },
      "cells": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1024,
        "items": {"description": "[x, y, z] or {x, y, z} in metres."},
        "description": "Remove the chute in each cell."
      },
      "allow_split": {
        "type": "boolean",
        "description": "Let the removal split networks or leave ports joined to nothing. Default false."
      },
      "root": {"$ref": "defs/root.json"},
      "wait": {"$ref": "defs/wait.json"},
      "dry_run": {"$ref": "defs/dry_run.json"},
      "confirm": {"$ref": "defs/confirm.json"},
      "from_id": {"$ref": "defs/from_id.json"},
      "refund": {"$ref": "defs/refund.json"},
      "refund_to": {"$ref": "defs/refund_to.json"},
      "include_links": {"$ref": "defs/include_links.json"},
      "include_notes": {"$ref": "defs/include_notes.json"},
      "include_network_devices": {"$ref": "defs/include_network_devices.json"},
      "limit": {"type": "integer", "minimum": 0, "maximum": 1024, "description": "Pieces listed; default 5, 0 for none."},
      "verbose": {"$ref": "defs/verbose.json"},
      "job_id": {"$ref": "defs/job_id.json"}
    },
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "job_id": {"type": ["string", "null"]},
      "tool": {"type": "string"},
      "status": {"type": "string"},
      "position": {"type": "integer"},
      "running_job_id": {"type": ["string", "null"]},
      "preflight": {},
      "preflight_summary": {"type": ["object", "null"]},
      "final_check": {"type": ["object", "null"]},
      "log": {"type": ["object", "null"]},
      "verification": {"type": ["object", "null"]},
      "gas_check": {"type": ["object", "null"]},
      "error": {"type": ["object", "null"]},
      "grade": {"type": ["string", "null"]},
      "ready": {"type": "boolean"},
      "problems": {"type": "array"},
      "warnings": {"type": "array"},
      "cells_total": {"type": "integer"},
      "placed": {"type": "integer"},
      "changed": {"type": "integer"},
      "kept": {"type": "integer"},
      "removed_count": {"type": "integer"},
      "air_cells": {"type": ["integer", "null"]},
      "cells": {"type": "array"},
      "removals": {"type": "array"},
      "materials": {"type": "object"},
      "networks_before": {"type": "array"},
      "networks_after": {"type": "array"},
      "would_bridge": {"type": "array"},
      "would_split": {"type": "array"},
      "links": {"type": ["object", "null"]},
      "notes": {"type": ["array", "null"]},
      "result": {"type": ["object", "null"]},
      "waiting": {"type": "integer"},
      "message": {"type": "string"}
    }
  },
  "x-views": ["JobQueuedView", "RunJobView", "RunReportView", "BuildJobView", "JobBusyView", "JobDroppedView"],
  "x-shaping": "lists",
  "x-job": {"poll_param": "job_id"}
}
