{
  "name": "read_logic_many",
  "summary": "Read up to 256 logic values in one call; each result stands alone, by index, with its own error. Read only.",
  "help": {
    "text": "Each result is {index, ok, reference_id, logic_type, value}, or {index, ok: false, reference_id, logic_type, error}; reference_id and logic_type are null when the entry's own could not be read. read_devices also reads slots, atmospheres and reagents in one frame.",
    "keys": "gateway_id, results, count, success_count, error_count.",
    "shared": ["gateways", "logic"]
  },
  "class": "read",
  "cost": "bounded",
  "x-cost-when": [{"when": {"reads": {"present": true}}, "cost": "bounded", "per_item": "reads"}],
  "params": {
    "type": "object",
    "properties": {
      "gateway_id": {"$ref": "defs/gateway_id.json"},
      "reads": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "items": {
          "type": "object",
          "properties": {
            "reference_id": {"type": "string", "description": "The device's reference id (list_devices)."},
            "logic_type": {
              "oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0, "maximum": 65535}],
              "description": "A logic type name (Temperature) or number."
            }
          },
          "required": ["reference_id", "logic_type"],
          "additionalProperties": false
        },
        "description": "The reads, up to 256, each {reference_id, logic_type}."
      }
    },
    "required": ["reads"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "gateway_id": {"type": "string"},
      "results": {"type": "array"},
      "count": {"type": "integer"},
      "success_count": {"type": "integer"},
      "error_count": {"type": "integer"}
    }
  },
  "x-views": ["LogicBatchView"],
  "x-shaping": "lists"
}
