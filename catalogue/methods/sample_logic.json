{
  "name": "sample_logic",
  "description": "Sample up to 32 logic values for at most 30 seconds and return their initial readings plus timestamped changes.",
  "class": "read",
  "cost": "stream",
  "params": {
    "type": "object",
    "properties": {
      "gateway_id": {"$ref": "defs/gateway_id.json"},
      "targets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "reference_id": {"type": "string", "description": "Target device reference ID."},
            "logic_type": {
              "oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0, "maximum": 65535}],
              "description": "LogicType enum name or numeric ushort ID."
            }
          },
          "required": ["reference_id", "logic_type"],
          "additionalProperties": false
        }
      },
      "duration_seconds": {"type": "number", "minimum": 0.1, "maximum": 30, "description": "Observation duration; defaults to 5 seconds."},
      "interval_seconds": {
        "type": "number",
        "minimum": 0.05,
        "maximum": 5,
        "description": "Least time between samples; defaults to 0.5 seconds. At most 120 samples may be requested. Each sample is a round trip to the game's main thread, so a short interval on a busy or slow game yields fewer samples than asked; sample_count says how many were taken."
      }
    },
    "required": ["targets"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "gateway_id": {"type": ["string", "null"]},
      "started_at_utc": {"type": "string"},
      "duration_seconds": {"type": "number"},
      "interval_seconds": {"type": "number"},
      "sample_count": {"type": "integer"},
      "change_count": {"type": "integer"},
      "changes": {"type": "array"}
    }
  },
  "x-shaping": "lists",
  "x-duration": {"param": "duration_seconds", "max_s": 30},
  "x-runs-in": "sidecar"
}
