{
  "name": "read_logic",
  "summary": "Read one logic value from a device, by logic type name or number. Read only.",
  "help": {
    "text": "Any device in the world; gateway_id narrows the scope. read_logic_many and read_devices read many values in one call.",
    "shared": ["gateways", "logic"]
  },
  "class": "read",
  "cost": "instant",
  "params": {
    "type": "object",
    "properties": {
      "gateway_id": {"$ref": "defs/gateway_id.json"},
      "reference_id": {"type": "string", "description": "The device's reference id (list_devices)."},
      "logic_type": {
        "oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0, "maximum": 65535}],
        "description": "A logic type name (Temperature) or number."
      }
    },
    "required": ["reference_id", "logic_type"],
    "additionalProperties": false
  },
  "reply": {
    "type": "object",
    "properties": {
      "gateway_id": {"type": "string"},
      "reference_id": {"type": "string"},
      "logic_type": {"type": "object"},
      "value": {"type": "number"}
    }
  },
  "x-views": ["LogicReadView"],
  "x-shaping": "none"
}
