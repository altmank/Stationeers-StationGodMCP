{
  "type": "array",
  "minItems": 1,
  "maxItems": 128,
  "description": "Things to read, up to 128, each with at least one part.",
  "items": {
    "type": "object",
    "properties": {
      "reference_id": {"type": "string", "description": "A device or thing; for atmosphere alone also a pipe network or atmosphere id."},
      "logic": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0, "maximum": 65535}],
          "description": "A logic type name or number."
        },
        "description": "Logic types to read, up to 64; each value comes back under the string sent."
      },
      "slots": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {
            "index": {"type": "integer", "minimum": 0, "description": "Slot index, as inspect_slots numbers them."},
            "logic": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0, "maximum": 65535}],
                "description": "A slot logic type name or number."
              },
              "description": "Slot logic types; left out, every one the slot reads."
            }
          },
          "required": ["index"],
          "additionalProperties": false
        },
        "description": "Slots to read, up to 16."
      },
      "atmosphere": {
        "type": "object",
        "properties": {
          "of": {"type": "string", "enum": ["internal"], "description": "internal: only its internal atmosphere."},
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64,
            "description": "A device port index: the pipe network joined there."
          }
        },
        "additionalProperties": false,
        "description": "{} its own atmosphere, {of: \"internal\"}, or {port: n}."
      },
      "reagents": {"type": "boolean", "description": "true: the reagents it holds, as the reagents tool reads them."}
    },
    "required": ["reference_id"],
    "additionalProperties": false
  }
}
